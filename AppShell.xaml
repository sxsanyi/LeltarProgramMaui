<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:LeltarKezelo.Views"
       x:Class="LeltarKezelo.AppShell"
       Title="LeltárKezelő"
       Shell.FlyoutBehavior="Disabled">

    <!-- A ContentTemplate-tel megadott oldal a DI konténerből példányosul. -->
    <ShellContent Title="Leltár"
                  Route="products"
                  ContentTemplate="{DataTemplate views:ProductListPage}" />
</Shell>
